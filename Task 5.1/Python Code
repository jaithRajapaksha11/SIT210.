import tkinter as tk
import serial
import time

PORT = "COM13" 
BAUD = 9600

arduino = serial.Serial(PORT, BAUD, timeout=1)
time.sleep(2)

def send_command(cmd):
    arduino.write((cmd + "\n").encode())

def select_room():
    room = room_var.get()
    if room == "Living Room":
        send_command("LIVING")
    elif room == "Bathroom":
        send_command("BATHROOM")
    elif room == "Closet":
        send_command("CLOSET")

def exit_app():
    send_command("OFF")
    arduino.close()
    root.destroy()

root = tk.Tk()
root.title("Home Lights")

room_var = tk.StringVar()

tk.Label(root, text="Select Room").pack()

tk.Radiobutton(root, text="Living Room", variable=room_var,
               value="Living Room", command=select_room).pack()

tk.Radiobutton(root, text="Bathroom", variable=room_var,
               value="Bathroom", command=select_room).pack()

tk.Radiobutton(root, text="Closet", variable=room_var,
               value="Closet", command=select_room).pack()

tk.Button(root, text="Exit", command=exit_app).pack()

root.mainloop()
