import tkinter as tk
from gpiozero import LED

# Set up LEDs on Raspberry Pi GPIO pins
living_led = LED(17)
bathroom_led = LED(27)
closet_led = LED(22)

def turn_on_selected():
    room = selected_room.get()

    # Turn all LEDs off first
    living_led.off()
    bathroom_led.off()
    closet_led.off()

    # Turn on only the selected room LED
    if room == "Living Room":
        living_led.on()
    elif room == "Bathroom":
        bathroom_led.on()
    elif room == "Closet":
        closet_led.on()

def exit_program():
    # Turn everything off before closing
    living_led.off()
    bathroom_led.off()
    closet_led.off()
    window.destroy()

# Create the main window
window = tk.Tk()
window.title("Home Light Control")
window.geometry("300x220")

title_label = tk.Label(window, text="Select a Room", font=("Arial", 16))
title_label.pack(pady=10)

selected_room = tk.StringVar()
selected_room.set("")

living_radio = tk.Radiobutton(
    window,
    text="Living Room",
    variable=selected_room,
    value="Living Room",
    command=turn_on_selected
)
living_radio.pack(anchor="w", padx=20, pady=5)

bathroom_radio = tk.Radiobutton(
    window,
    text="Bathroom",
    variable=selected_room,
    value="Bathroom",
    command=turn_on_selected
)
bathroom_radio.pack(anchor="w", padx=20, pady=5)

closet_radio = tk.Radiobutton(
    window,
    text="Closet",
    variable=selected_room,
    value="Closet",
    command=turn_on_selected
)
closet_radio.pack(anchor="w", padx=20, pady=5)

exit_button = tk.Button(window, text="Exit", command=exit_program)
exit_button.pack(pady=20)

window.protocol("WM_DELETE_WINDOW", exit_program)
window.mainloop()
