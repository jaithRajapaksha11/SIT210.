import tkinter as tk
from gpiozero import LED

living_led = LED(17)
bathroom_led = LED(27)
closet_led = LED(22)

def update_leds():
    if living_var.get() == 1:
        living_led.on()
    else:
        living_led.off()
    if bathroom_var.get() == 1:
        bathroom_led.on()
    else:
        bathroom_led.off()
    if closet_var.get() == 1:
        closet_led.on()
    else:
        closet_led.off()

def exit_program():
    living_led.off()
    bathroom_led.off()
    closet_led.off()
    window.destroy()

window = tk.Tk()
window.title("Home Light Control")
window.geometry("300x220")

tk.Label(window, text="Select Rooms", font=("Arial", 16)).pack(pady=10)

living_var = tk.IntVar()
bathroom_var = tk.IntVar()
closet_var = tk.IntVar()

tk.Checkbutton(
    window,
    text="Living Room",
    variable=living_var,
    command=update_leds
).pack(anchor="w", padx=20, pady=5)

tk.Checkbutton(
    window,
    text="Bathroom",
    variable=bathroom_var,
    command=update_leds
).pack(anchor="w", padx=20, pady=5)

tk.Checkbutton(
    window,
    text="Closet",
    variable=closet_var,
    command=update_leds
).pack(anchor="w", padx=20, pady=5)

tk.Button(window, text="Exit", command=exit_program).pack(pady=20)

window.mainloop()
